lemma chi_prod_delta {k : ℕ} {F : Type} [Field F] [BEq F] [LawfulBEq F]
    (w m : Index k) :
    (∏ s, eval (toPoint m) (chi s w F)) = if w = m then 1 else 0 := by
  simp only [eval_chi, Finset.prod_boole, Finset.mem_univ, forall_const, ← funext_iff]


/--
TODO: review this
Rotate three nested sums: bring the innermost index to the outside. -/
lemma sum_rotate {k : ℕ} {M : Type} [AddCommMonoid M]
    (g : Index k → Index k → Index k → M) :
    (∑ a, ∑ b, ∑ c, g a b c) = ∑ c, ∑ a, ∑ b, g a b c := by
  rw [Finset.sum_congr rfl (fun a _ => Finset.sum_comm (f := fun b c => g a b c))]
  rw [Finset.sum_comm]

/--
we have proven the identity layer_values_eq_sum in GKR/Properties/Circuit.lean
now we prove this equality with multilinear extensionn taken on both sides
-/
theorem layer_sum_multilinear_extension
{k d : ℕ}
{F : Type} [Field F] [BEq F] [LawfulBEq F]
(c : Circuit k d)
(input : Index k → F)
(l : Fin d)
(r : Fin k → F)
: (linearizeFunction (layerValues c input l.castSucc)).eval r
= ∑ bb : Index k, ∑ cc : Index k,
    ( (addTilde F c l).eval (gluePoint r (toPoint bb) (toPoint cc))
        * ( (linearizeFunction (layerValues c input l.succ)).eval (toPoint bb)
          + (linearizeFunction (layerValues c input l.succ)).eval (toPoint cc) )
    + (mulTilde F c l).eval (gluePoint r (toPoint bb) (toPoint cc))
        * ( (linearizeFunction (layerValues c input l.succ)).eval (toPoint bb)
          * (linearizeFunction (layerValues c input l.succ)).eval (toPoint cc) ) ) := by
  unfold addTilde
  unfold mulTilde
  simp only [← function_linearization_agrees]
  rw [eval_linearizeFunction]
  simp only [layer_values_eq_sum]
  unfold linearizeFunction
  simp only [eval_sum_eq_sum_eval, eval_mul, eval_C, eval_prod_eq_prod_eval]
  simp only [sum_index_glue]
  simp only [chi_prod_glue]
  simp only [part₀_glueIndex, part₁_glueIndex, part₂_glueIndex, chi_prod_delta,
            mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  simp only [Finset.sum_mul]
  simp only [← Finset.sum_add_distrib]
  conv_rhs => rw [sum_rotate]
  apply Finset.sum_congr rfl; intro z _
  apply Finset.sum_congr rfl; intro x _
  apply Finset.sum_congr rfl; intro y _
  ring
